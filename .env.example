# ==============================================================================
# Docker & Domain Configuration (Root .env)
# ==============================================================================
# You can set FRONTEND_URL and BACKEND_URL to:
#
# Option A — Separate Frontend & Backend Domains / Subdomains:
#   FRONTEND_URL=https://yourdomain.com
#   BACKEND_URL=https://api.yourdomain.com
#   SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com
#
# Option B — Single Unified Domain (Nginx serves both / and /api):
#   FRONTEND_URL=https://yourdomain.com
#   BACKEND_URL=https://yourdomain.com
#   SANCTUM_STATEFUL_DOMAINS=yourdomain.com,www.yourdomain.com
#
# Option C — Local Development (Default):
#   FRONTEND_URL=http://localhost:3000
#   BACKEND_URL=http://localhost:8000
#   SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
# ==============================================================================

APP_ENV=local
APP_DEBUG=true
NODE_ENV=development

# Public URLs (set these to your domain(s) in production)
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000

# Optional override if your public API path differs from ${BACKEND_URL}/api/v1
# NUXT_PUBLIC_API_BASE=https://api.yourdomain.com/api/v1
NUXT_API_BASE=http://nginx/api/v1

# Exposed Host Ports
FRONTEND_PORT=3000
BACKEND_PORT=8000

# PostgreSQL & Redis (internal to the Docker network only, no host ports)
DB_DATABASE=blog
DB_USERNAME=blog
DB_PASSWORD=secret
